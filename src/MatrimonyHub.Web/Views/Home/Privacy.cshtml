@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="matrimony-card p-5 rounded-4">
                <h1 class="brand-font display-6 fw-bold text-dark mb-4">Privacy & Data Protection</h1>
                <p class="text-muted mb-4">Last Updated: October 2026</p>

                <h5 class="fw-bold">1. Information We Collect</h5>
                <p class="text-muted small">We collect profile information you voluntarily submit, including basic demographic details, educational records, occupational history, lifestyle preferences, and profile photographs.</p>

                <h5 class="fw-bold mt-4">2. Non-Disclosure of Sensitive Government ID</h5>
                <p class="text-muted small">Your National ID (NID) number and uploaded identification documents are securely stored in protected directories and are NEVER displayed publicly or shared with other members. They are used exclusively by verified administrators for authenticity review.</p>

                <h5 class="fw-bold mt-4">3. Contact Information Protection</h5>
                <p class="text-muted small">Your phone number, email address, and precise residence remain hidden from general view. They are only disclosed to an authenticated member who has formally completed the required payment and contact access verification workflow.</p>

                <h5 class="fw-bold mt-4">4. Payment Security</h5>
                <p class="text-muted small">We do not store your bank account passwords, debit/credit card CVV codes, or mobile wallet PINs. All financial transactions are processed through tokenized and PCI-DSS compliant payment gateways.</p>
            </div>
        </div>
    </div>
</div>
