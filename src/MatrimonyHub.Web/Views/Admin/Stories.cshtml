@model List<SuccessStoryDto>
@{
    ViewData["Title"] = "Success Stories Moderation - Admin";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="brand-font h3 fw-bold text-dark mb-1">Success Stories Moderation</h1>
            <p class="text-muted small">Review, approve, or remove matrimonial success stories submitted by members</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to Overview</a>
    </div>

    @if (Model.Any())
    {
        <div class="row g-4">
            @foreach (var s in Model)
            {
                <div class="col-lg-6">
                    <div class="matrimony-card p-4 h-100 d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="fw-bold text-dark mb-0">@s.CoupleNames</h5>
                            @if (s.Status == SuccessStoryStatus.Approved)
                            {
                                <span class="badge bg-success">Approved</span>
                            }
                            else if (s.Status == SuccessStoryStatus.Pending)
                            {
                                <span class="badge bg-warning">Pending Review</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Rejected</span>
                            }
                        </div>

                        <h6 class="small text-primary fw-bold mb-1">"@s.StoryTitle"</h6>
                        <p class="small text-muted mb-2"><i class="bi bi-geo-alt me-1"></i> @s.Location | Married: @s.MarriageDate.ToString("MMM dd, yyyy")</p>
                        
                        <p class="small text-muted flex-grow-1">@s.StoryDescription</p>

                        <div class="d-flex gap-2 pt-3 border-top mt-auto">
                            @if (s.Status != SuccessStoryStatus.Approved)
                            {
                                <form asp-action="ApproveStory" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@s.Id" />
                                    <button type="submit" class="btn btn-sm btn-success">Approve Story</button>
                                </form>
                            }
                            @if (s.Status != SuccessStoryStatus.Rejected)
                            {
                                <form asp-action="RejectStory" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@s.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-warning">Reject</button>
                                </form>
                            }
                            <form asp-action="DeleteStory" method="post" class="d-inline ms-auto">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@s.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Permanently delete this story?');">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="matrimony-card p-5 text-center my-4">
            <h4 class="fw-bold mb-2">No Success Stories to Moderate</h4>
        </div>
    }
</div>
