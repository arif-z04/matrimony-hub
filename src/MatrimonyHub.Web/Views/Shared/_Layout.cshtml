<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Matrimony Hub | Trusted Bangladeshi Matrimony</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-matrimony sticky-top">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-heart-pulse-fill"></i>
                    Matrimony<span>Hub</span>
                </a>
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                    <i class="bi bi-list fs-2 text-dark"></i>
                </button>
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Matches" ? "active" : "")" asp-controller="Matches" asp-action="Index">Find Matches</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "SuccessStories" ? "active" : "")" asp-controller="SuccessStories" asp-action="Index">Success Stories</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "About" ? "active" : "")" asp-controller="Home" asp-action="About">About Us</a>
                        </li>
                    </ul>

                    <ul class="navbar-nav align-items-lg-center gap-2">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="btn btn-sm btn-outline-danger px-3" asp-controller="Admin" asp-action="Index">
                                        <i class="bi bi-shield-lock-fill me-1"></i> Admin Portal
                                    </a>
                                </li>
                            }
                            <li class="nav-item">
                                <a class="nav-link position-relative" asp-controller="Notifications" asp-action="Index" title="Notifications">
                                    <i class="bi bi-bell fs-5"></i>
                                </a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" id="userMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; font-size: 0.85rem; font-weight: 600;">
                                        @(User.Identity.Name?[..1].ToUpper() ?? "U")
                                    </div>
                                    <span class="d-none d-lg-inline">Account</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3" aria-labelledby="userMenu">
                                    <li><a class="dropdown-item py-2" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-grid-fill me-2 text-muted"></i>Dashboard</a></li>
                                    <li><a class="dropdown-item py-2" asp-controller="Profile" asp-action="Edit"><i class="bi bi-person-fill me-2 text-muted"></i>My Profile</a></li>
                                    <li><a class="dropdown-item py-2" asp-controller="Profile" asp-action="Preferences"><i class="bi bi-sliders me-2 text-muted"></i>Partner Preferences</a></li>
                                    <li><a class="dropdown-item py-2" asp-controller="Favorites" asp-action="Index"><i class="bi bi-heart-fill me-2 text-danger"></i>Favorites</a></li>
                                    <li><a class="dropdown-item py-2" asp-controller="Contact" asp-action="Unlocked"><i class="bi bi-telephone-fill me-2 text-success"></i>Unlocked Contacts</a></li>
                                    <li><a class="dropdown-item py-2" asp-controller="Verification" asp-action="Index"><i class="bi bi-patch-check-fill me-2 text-primary"></i>NID Verification</a></li>
                                    <li><a class="dropdown-item py-2" asp-controller="Payment" asp-action="History"><i class="bi bi-credit-card-fill me-2 text-muted"></i>Payment History</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Auth" asp-action="Logout" method="post" class="px-2">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger rounded-2 py-2"><i class="bi bi-box-arrow-right me-2"></i>Sign Out</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link px-3" asp-controller="Auth" asp-action="Login">Sign In</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary px-4" asp-controller="Auth" asp-action="Register">Create Profile</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="container mt-3">
            <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 d-flex align-items-center" role="alert">
                <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                <div>@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="container mt-3">
            <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 d-flex align-items-center" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                <div>@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    }

    @if (TempData["InfoMessage"] != null)
    {
        <div class="container mt-3">
            <div class="alert alert-info alert-dismissible fade show shadow-sm border-0 d-flex align-items-center" role="alert">
                <i class="bi bi-info-circle-fill me-2 fs-5"></i>
                <div>@TempData["InfoMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    }

    <main role="main" class="flex-grow-1">
        @RenderBody()
    </main>

    <footer>
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <h5 class="brand-font text-white mb-3">Matrimony<span style="color: var(--secondary-color);">Hub</span></h5>
                    <p class="small text-light opacity-75">
                        Bangladesh's premier trusted matrimonial network designed for dignified marriage matching, verified government NID identities, and transparent family values.
                    </p>
                    <div class="d-flex gap-3 text-secondary fs-5 mt-3">
                        <i class="bi bi-shield-check text-success"></i>
                        <span class="small text-white opacity-75">100% NID Verified Profiles Available</span>
                    </div>
                </div>
                <div class="col-lg-2 col-md-6">
                    <h6 class="text-uppercase text-white fw-bold mb-3 small">Quick Links</h6>
                    <ul class="list-unstyled small d-flex flex-column gap-2">
                        <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                        <li><a asp-controller="Matches" asp-action="Index">Find Matches</a></li>
                        <li><a asp-controller="SuccessStories" asp-action="Index">Success Stories</a></li>
                        <li><a asp-controller="Home" asp-action="About">About Us</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h6 class="text-uppercase text-white fw-bold mb-3 small">Security & Trust</h6>
                    <ul class="list-unstyled small d-flex flex-column gap-2">
                        <li><a asp-controller="Verification" asp-action="Index">NID Identity Verification</a></li>
                        <li><a asp-controller="Home" asp-action="Privacy">Privacy Policy</a></li>
                        <li><a href="#">Contact Unlock Guidelines</a></li>
                        <li><a href="#">Safety Tips</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h6 class="text-uppercase text-white fw-bold mb-3 small">Supported Gateways</h6>
                    <p class="small text-light opacity-75 mb-2">Instant and secure checkout via:</p>
                    <div class="d-flex flex-wrap gap-2">
                        <span class="badge bg-light text-dark px-2 py-1">bKash</span>
                        <span class="badge bg-light text-dark px-2 py-1">SSLCommerz</span>
                        <span class="badge bg-light text-dark px-2 py-1">Nagad</span>
                        <span class="badge bg-light text-dark px-2 py-1">Visa / Mastercard</span>
                    </div>
                </div>
            </div>
            <hr class="border-secondary opacity-25 my-4">
            <div class="row align-items-center">
                <div class="col-md-6 small text-center text-md-start opacity-75">
                    &copy; 2026 Matrimony Hub. All rights reserved. Built for Bangladesh.
                </div>
                <div class="col-md-6 small text-center text-md-end mt-2 mt-md-0 opacity-75">
                    Find Someone Special. Build a Lifetime Together.
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
