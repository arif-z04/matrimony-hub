@{
    ViewData["Title"] = "Page Not Found";
}

<div class="container py-5 text-center my-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="p-5 matrimony-card rounded-4">
                <i class="bi bi-compass text-danger display-1 mb-3"></i>
                <h1 class="h2 fw-bold text-dark mb-2">404 - Page Not Found</h1>
                <p class="text-muted mb-4">
                    The matrimonial page or profile you are looking for does not exist, has been removed, or the link is expired.
                </p>
                <div class="d-flex justify-content-center gap-3">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary px-4">Home</a>
                    <a asp-controller="Matches" asp-action="Index" class="btn btn-primary px-4">Find Matches</a>
                </div>
            </div>
        </div>
    </div>
</div>
