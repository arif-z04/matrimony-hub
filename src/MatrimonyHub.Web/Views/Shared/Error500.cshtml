@{
    ViewData["Title"] = "System Error";
}

<div class="container py-5 text-center my-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="p-5 matrimony-card rounded-4">
                <i class="bi bi-exclamation-octagon text-danger display-1 mb-3"></i>
                <h1 class="h2 fw-bold text-dark mb-2">500 - Server Error</h1>
                <p class="text-muted mb-4">
                    An unexpected system condition occurred. Our technical staff has been notified. Please try again shortly.
                </p>
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4">Back to Home</a>
            </div>
        </div>
    </div>
</div>
