@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-5 text-center my-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="p-5 matrimony-card rounded-4">
                <i class="bi bi-shield-x text-warning display-1 mb-3"></i>
                <h1 class="h2 fw-bold text-dark mb-2">403 - Access Denied</h1>
                <p class="text-muted mb-4">
                    You do not have administrative permissions or authorization to access this secured matrimonial resource.
                </p>
                <div class="d-flex justify-content-center gap-3">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary px-4">Return to Safety</a>
                    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary px-4">User Dashboard</a>
                </div>
            </div>
        </div>
    </div>
</div>
