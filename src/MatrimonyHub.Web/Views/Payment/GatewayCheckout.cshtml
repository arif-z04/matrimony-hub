@{
    Layout = null; // Clean gateway modal look
    var gateway = ViewBag.Gateway as string ?? "Gateway";
    var txn = ViewBag.Txn as string ?? "";
    var amount = (decimal)(ViewBag.Amount ?? 500m);
    var target = ViewBag.TargetProfile as UserProfile;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@gateway Secure Payment Authorization</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body { background-color: #F4F6F9; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
        .gateway-box { max-width: 440px; margin: 50px auto; background: #fff; border-radius: 16px; box-shadow: 0 10px 30px rgba(0,0,0,0.08); overflow: hidden; }
        .gateway-header { background: @(gateway == "bKash" ? "#D12053" : (gateway == "Nagad" ? "#F7941D" : "#1A2849")); color: #fff; padding: 24px; text-align: center; }
    </style>
</head>
<body>
    <div class="container">
        <div class="gateway-box">
            <div class="gateway-header">
                <h4 class="fw-bold mb-1">@gateway Gateway</h4>
                <p class="small mb-0 opacity-75">Secure Merchant Checkout Authorization</p>
            </div>
            <div class="p-4">
                <div class="bg-light p-3 rounded-3 mb-3 border">
                    <div class="d-flex justify-content-between small text-muted mb-1">
                        <span>Merchant:</span>
                        <strong class="text-dark">Matrimony Hub Ltd.</strong>
                    </div>
                    <div class="d-flex justify-content-between small text-muted mb-1">
                        <span>Transaction ID:</span>
                        <span class="font-monospace text-dark">@txn</span>
                    </div>
                    <div class="d-flex justify-content-between small text-muted mb-1">
                        <span>Purpose:</span>
                        <span class="text-dark">Partner Contact Unlock</span>
                    </div>
                    <hr class="my-2">
                    <div class="d-flex justify-content-between">
                        <strong>Amount:</strong>
                        <strong class="text-primary fs-5">BDT @amount.ToString("N2")</strong>
                    </div>
                </div>

                <div class="p-2 mb-3 small text-muted text-center" style="font-size: 0.8rem;">
                    <i class="bi bi-lock-fill text-success"></i> 256-Bit SSL Encrypted Connection
                </div>

                <!-- Real Form Calling Server-Side Callback -->
                <form method="post" action="/Payment/ProcessCallback" class="d-grid gap-2">
                    <input type="hidden" name="TransactionId" value="@txn" />
                    <input type="hidden" name="GatewayTransactionId" value="@($"{gateway[..2].ToUpper()}-TRX-{Guid.NewGuid():N}"[..16])" />
                    <input type="hidden" name="Status" value="3" /> <!-- 3: Successful -->
                    <input type="hidden" name="RawPayload" value="Gateway=@gateway&Confirmed=true" />

                    <button type="submit" class="btn btn-primary py-2 fw-semibold" style="background-color: @(gateway == "bKash" ? "#D12053" : (gateway == "Nagad" ? "#F7941D" : "#1A2849")); border: none;">
                        <i class="bi bi-check-circle-fill me-1"></i> Authorize & Confirm Payment
                    </button>
                </form>

                <form method="post" action="/Payment/ProcessCallback" class="d-grid mt-2">
                    <input type="hidden" name="TransactionId" value="@txn" />
                    <input type="hidden" name="Status" value="5" /> <!-- 5: Cancelled -->
                    <input type="hidden" name="FailureReason" value="Transaction cancelled by user at gateway" />
                    <button type="submit" class="btn btn-outline-secondary btn-sm py-1 border-0">
                        Cancel Payment
                    </button>
                </form>
            </div>
        </div>
    </div>
</body>
</html>
