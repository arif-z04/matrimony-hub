@model InitiatePaymentDto
@{
    ViewData["Title"] = "Unlock Contact Details - Secure Payment";
    var target = ViewBag.TargetProfile as ProfileDetailDto;
    var fee = (decimal)(ViewBag.Fee ?? 500.00m);
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9">
            <div class="matrimony-card p-4 p-md-5 rounded-4">
                <div class="text-center mb-4">
                    <span class="badge px-3 py-2 rounded-pill bg-light text-primary mb-2 fw-semibold">Secure Checkout</span>
                    <h2 class="brand-font h3 fw-bold mb-1">Unlock Partner Contact</h2>
                    <p class="text-muted small">One-time payment to obtain verified phone number, email, and direct address</p>
                </div>

                <!-- Target Profile Card -->
                @if (target != null)
                {
                    <div class="p-3 bg-light rounded-3 border mb-4 d-flex gap-3 align-items-center">
                        <img src="@(string.IsNullOrEmpty(target.Photos.FirstOrDefault()?.PhotoUrl) ? (target.Gender == Gender.Female ? "https://randomuser.me/api/portraits/women/65.jpg" : "https://randomuser.me/api/portraits/men/65.jpg") : target.Photos.First().PhotoUrl)" 
                             alt="@target.FullName" 
                             class="rounded-3" 
                             style="width: 70px; height: 70px; object-fit: cover;" />
                        <div>
                            <h5 class="fw-bold mb-0 text-dark">@target.FullName, @target.Age</h5>
                            <p class="small text-muted mb-1"><i class="bi bi-geo-alt-fill text-danger"></i> @target.City, @target.Division</p>
                            <span class="small text-secondary"><i class="bi bi-briefcase me-1"></i> @target.Occupation</span>
                        </div>
                    </div>
                }

                <!-- Fee Breakdown -->
                <div class="border rounded-3 p-3 mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small">Contact Access Fee:</span>
                        <span class="fw-bold">BDT @fee.ToString("N2")</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small">VAT / Service Tax:</span>
                        <span class="text-success small fw-semibold">BDT 0.00 (Included)</span>
                    </div>
                    <hr class="my-2">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-bold text-dark">Total Payable:</span>
                        <span class="h5 fw-bold text-primary mb-0">BDT @fee.ToString("N2")</span>
                    </div>
                </div>

                <form asp-action="Initiate" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="TargetProfileId" />

                    <label class="form-label small fw-bold text-dark mb-2">Select Payment Gateway</label>
                    <div class="row g-2 mb-4">
                        <div class="col-6">
                            <label class="border rounded-3 p-3 w-100 d-flex align-items-center gap-2 cursor-pointer gateway-option">
                                <input type="radio" asp-for="Gateway" value="1" class="form-check-input" />
                                <div class="small fw-bold">bKash</div>
                            </label>
                        </div>
                        <div class="col-6">
                            <label class="border rounded-3 p-3 w-100 d-flex align-items-center gap-2 cursor-pointer gateway-option">
                                <input type="radio" asp-for="Gateway" value="2" class="form-check-input" />
                                <div class="small fw-bold">SSLCommerz</div>
                            </label>
                        </div>
                        <div class="col-6">
                            <label class="border rounded-3 p-3 w-100 d-flex align-items-center gap-2 cursor-pointer gateway-option">
                                <input type="radio" asp-for="Gateway" value="3" class="form-check-input" />
                                <div class="small fw-bold">Nagad</div>
                            </label>
                        </div>
                        <div class="col-6">
                            <label class="border rounded-3 p-3 w-100 d-flex align-items-center gap-2 cursor-pointer gateway-option bg-light">
                                <input type="radio" asp-for="Gateway" value="4" class="form-check-input" checked />
                                <div class="small fw-bold text-primary">Sandbox (Gateway)</div>
                            </label>
                        </div>
                    </div>

                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-primary py-2 fs-6">
                            <i class="bi bi-shield-check me-1"></i> Proceed to Payment Gateway
                        </button>
                    </div>

                    <div class="text-center">
                        <a asp-controller="Profile" asp-action="Details" asp-route-id="@Model.TargetProfileId" class="small text-muted text-decoration-none">
                            <i class="bi bi-arrow-left me-1"></i> Cancel and Return
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
