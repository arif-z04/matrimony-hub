@model List<PaymentHistoryDto>
@{
    ViewData["Title"] = "My Payment History";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="brand-font h3 fw-bold text-dark mb-1">My Payment History</h1>
            <p class="text-muted small">Audit history of your contact unlock payments and gateway transactions</p>
        </div>
        <a asp-controller="Contact" asp-action="Unlocked" class="btn btn-outline-primary btn-sm">My Unlocked Contacts</a>
    </div>

    <div class="matrimony-card p-4 rounded-4">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle small mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Transaction ID</th>
                            <th>Purpose</th>
                            <th>Target Candidate</th>
                            <th>Amount</th>
                            <th>Gateway</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model)
                        {
                            <tr>
                                <td class="font-monospace fw-bold">@p.TransactionId</td>
                                <td>@p.Purpose</td>
                                <td>@(p.TargetProfileName ?? "Candidate")</td>
                                <td>@p.Currency @p.Amount.ToString("N2")</td>
                                <td><span class="badge bg-light text-dark border">@p.Gateway</span></td>
                                <td>
                                    @if (p.Status == PaymentStatus.Successful)
                                    {
                                        <span class="badge bg-success-subtle text-success">Successful</span>
                                    }
                                    else if (p.Status == PaymentStatus.Pending || p.Status == PaymentStatus.Processing)
                                    {
                                        <span class="badge bg-warning-subtle text-warning">Pending</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger">@p.Status</span>
                                    }
                                </td>
                                <td>@p.CreatedAt.ToString("MMM dd, yyyy HH:mm")</td>
                                <td>
                                    @if (p.TargetProfileId.HasValue && p.Status == PaymentStatus.Successful)
                                    {
                                        <a asp-controller="Profile" asp-action="Details" asp-route-id="@p.TargetProfileId" class="btn btn-sm btn-outline-primary py-0">View Contact</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-credit-card display-3 text-muted opacity-50 mb-2"></i>
                <h5 class="fw-bold">No Transactions Found</h5>
                <p class="text-muted small">You haven't made any payments on Matrimony Hub yet.</p>
            </div>
        }
    </div>
</div>
