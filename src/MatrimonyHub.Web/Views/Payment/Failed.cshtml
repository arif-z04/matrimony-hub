@{
    ViewData["Title"] = "Payment Failed";
    var payment = ViewBag.Payment as Payment;
    var reason = ViewBag.Reason as string ?? "Payment could not be confirmed.";
}

<div class="container py-5 text-center my-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="matrimony-card p-5 rounded-4">
                <i class="bi bi-x-circle-fill text-danger display-2 mb-3"></i>
                <h2 class="brand-font h3 fw-bold text-dark mb-2">Payment Was Not Completed</h2>
                <p class="text-muted small mb-4">
                    @reason
                </p>

                @if (payment != null)
                {
                    <div class="p-3 bg-light rounded-3 text-start small mb-4 border">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">Transaction ID:</span>
                            <span class="font-monospace">@payment.TransactionId</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Status:</span>
                            <span class="text-danger fw-bold">@payment.Status</span>
                        </div>
                    </div>
                }

                <div class="d-flex justify-content-center gap-3">
                    @if (payment?.TargetProfileId.HasValue == true)
                    {
                        <a asp-controller="Payment" asp-action="Checkout" asp-route-targetProfileId="@payment.TargetProfileId" class="btn btn-primary px-4">
                            Try Again
                        </a>
                    }
                    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary px-4">Dashboard</a>
                </div>
            </div>
        </div>
    </div>
</div>
