@model List<NotificationDto>
@{
    ViewData["Title"] = "Notifications";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="brand-font h3 fw-bold text-dark mb-1">Notifications & Activity</h1>
            <p class="text-muted small">Stay updated on profile visits, favorites, verification status, and contact unlocks</p>
        </div>
        @if (Model.Any(n => !n.IsRead))
        {
            <form asp-action="MarkAllAsRead" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-check2-all me-1"></i> Mark All as Read
                </button>
            </form>
        }
    </div>

    <div class="matrimony-card p-4 rounded-4">
        @if (Model.Any())
        {
            <div class="d-flex flex-column gap-3">
                @foreach (var n in Model)
                {
                    <div class="p-3 rounded-3 border d-flex justify-content-between align-items-center notification-item @(!n.IsRead ? "unread" : "bg-light")">
                        <div class="d-flex align-items-center gap-3">
                            <div class="p-2 rounded-circle @(n.Type == NotificationType.FavoriteAdded ? "bg-danger text-white" : (n.Type == NotificationType.VerificationApproved ? "bg-success text-white" : "bg-primary text-white"))">
                                <i class="bi @(n.Type == NotificationType.FavoriteAdded ? "bi-heart-fill" : (n.Type == NotificationType.VerificationApproved ? "bi-patch-check-fill" : (n.Type == NotificationType.ContactUnlocked ? "bi-unlock-fill" : "bi-bell-fill")))"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-1 text-dark">@n.Title</h6>
                                <p class="small text-muted mb-0">@n.Message</p>
                                <span class="small text-muted" style="font-size: 0.72rem;">@n.CreatedAt.ToString("MMM dd, yyyy HH:mm")</span>
                            </div>
                        </div>

                        @if (!n.IsRead)
                        {
                            <form asp-action="MarkAsRead" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@n.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-primary" title="Mark as read">
                                    <i class="bi bi-check2"></i>
                                </button>
                            </form>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-bell-slash display-3 text-muted opacity-50 mb-2"></i>
                <h5 class="fw-bold">No Notifications</h5>
                <p class="text-muted small">You're all caught up! Updates regarding your profile will appear here.</p>
            </div>
        }
    </div>
</div>
