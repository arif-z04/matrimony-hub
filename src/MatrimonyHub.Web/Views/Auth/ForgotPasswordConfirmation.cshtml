@{
    ViewData["Title"] = "Password Reset Requested";
}

<div class="container py-5 my-4 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="matrimony-card p-5 rounded-4">
                <i class="bi bi-envelope-check-fill text-success display-3 mb-3"></i>
                <h3 class="fw-bold mb-2">Check Your Email</h3>
                <p class="text-muted mb-4">
                    @ViewBag.Message
                </p>

                @if (!string.IsNullOrEmpty(ViewBag.Token as string))
                {
                    <div class="p-3 bg-light rounded text-start mb-4 border">
                        <span class="badge bg-secondary mb-2">Development Helper Token</span>
                        <p class="small text-break mb-2 font-monospace">@ViewBag.Token</p>
                        <a asp-action="ResetPassword" asp-route-token="@ViewBag.Token" class="btn btn-sm btn-outline-primary">
                            Proceed to Reset Password Page
                        </a>
                    </div>
                }

                <a asp-action="Login" class="btn btn-primary px-4">Return to Sign In</a>
            </div>
        </div>
    </div>
</div>
