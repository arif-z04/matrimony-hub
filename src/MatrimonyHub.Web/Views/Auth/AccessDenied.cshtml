@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-5 text-center my-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="matrimony-card p-5 rounded-4">
                <i class="bi bi-shield-slash text-danger display-1 mb-3"></i>
                <h2 class="fw-bold text-dark mb-2">Access Denied</h2>
                <p class="text-muted mb-4">
                    You do not have the required permissions or administrative privileges to view this section of Matrimony Hub.
                </p>
                <div class="d-flex justify-content-center gap-3">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary px-4">Home</a>
                    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary px-4">My Dashboard</a>
                </div>
            </div>
        </div>
    </div>
</div>
