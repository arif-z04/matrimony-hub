@model ForgotPasswordRequestDto
@{
    ViewData["Title"] = "Forgot Password";
}

<div class="container py-5 my-4">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="matrimony-card p-4 p-md-5 rounded-4 text-center">
                <i class="bi bi-shield-lock display-4 text-primary mb-3"></i>
                <h3 class="fw-bold mb-2">Forgot Password</h3>
                <p class="text-muted small mb-4">Enter your registered email address and we'll help you reset your password.</p>

                <form asp-action="ForgotPassword" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3 text-start">
                        <label asp-for="Email" class="form-label small fw-bold">Email Address</label>
                        <input asp-for="Email" class="form-control" placeholder="name@example.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary py-2">Send Reset Instructions</button>
                    </div>
                </form>

                <div class="mt-4 pt-2 border-top">
                    <a asp-action="Login" class="small text-primary fw-semibold"><i class="bi bi-arrow-left me-1"></i> Back to Sign In</a>
                </div>
            </div>
        </div>
    </div>
</div>
