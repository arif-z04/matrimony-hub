@model ResetPasswordRequestDto
@{
    ViewData["Title"] = "Reset Password";
}

<div class="container py-5 my-4">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="matrimony-card p-4 p-md-5 rounded-4">
                <h3 class="fw-bold mb-2 text-center">Reset Your Password</h3>
                <p class="text-muted small text-center mb-4">Enter your new password below</p>

                <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 small mb-3"></div>

                <form asp-action="ResetPassword" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Token" />

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label small fw-bold">Email Address</label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label small fw-bold">New Password</label>
                        <input asp-for="NewPassword" type="password" class="form-control" />
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label small fw-bold">Confirm New Password</label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary py-2">Update Password</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
