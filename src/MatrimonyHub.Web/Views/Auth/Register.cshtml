@model RegisterRequestDto
@{
    ViewData["Title"] = "Create Your Matrimonial Profile";
}

<div class="container py-5 my-3">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9">
            <div class="matrimony-card p-4 p-md-5 rounded-4">
                <div class="text-center mb-4">
                    <span class="badge px-3 py-2 rounded-pill bg-light text-primary mb-2 fw-semibold">Begin Your Journey</span>
                    <h2 class="brand-font fw-bold text-dark mb-1">Create a Matrimonial Profile</h2>
                    <p class="text-muted small">Register to discover compatible, verified life partners across Bangladesh</p>
                </div>

                <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 small mb-4" role="alert"></div>

                <form asp-action="Register" method="post">
                    @Html.AntiForgeryToken()

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="FullName" class="form-label small fw-bold">Full Name (as in NID) <span class="text-danger">*</span></label>
                            <input asp-for="FullName" class="form-control" placeholder="e.g. Tanvir Ahmed" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label small fw-bold">Email Address <span class="text-danger">*</span></label>
                            <input asp-for="Email" type="email" class="form-control" placeholder="name@example.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="form-label small fw-bold">Mobile Number (11 digits) <span class="text-danger">*</span></label>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="017xxxxxxxx" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Gender" class="form-label small fw-bold">Gender <span class="text-danger">*</span></label>
                            <select asp-for="Gender" class="form-select">
                                <option value="">-- Select Gender --</option>
                                <option value="1">Male (Groom)</option>
                                <option value="2">Female (Bride)</option>
                            </select>
                            <span asp-validation-for="Gender" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="DateOfBirth" class="form-label small fw-bold">Date of Birth <span class="text-danger">*</span></label>
                            <input asp-for="DateOfBirth" type="date" class="form-control" />
                            <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label small fw-bold">Password <span class="text-danger">*</span></label>
                            <input asp-for="Password" type="password" class="form-control" placeholder="At least 6 characters" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label small fw-bold">Confirm Password <span class="text-danger">*</span></label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Repeat your password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <div class="col-12 mt-3">
                            <div class="form-check">
                                <input asp-for="AcceptTerms" class="form-check-input" type="checkbox" id="acceptTerms">
                                <label class="form-check-label small text-muted" for="acceptTerms">
                                    I agree to the <a asp-controller="Home" asp-action="Privacy" target="_blank" class="text-primary fw-semibold">Terms of Service</a> and Privacy Policy. I confirm that all profile information submitted is truthful.
                                </label>
                            </div>
                            <span asp-validation-for="AcceptTerms" class="text-danger small"></span>
                        </div>

                        <div class="col-12 mt-4 d-grid">
                            <button type="submit" class="btn btn-primary py-2 fs-6">
                                <i class="bi bi-person-plus-fill me-1"></i> Register My Profile
                            </button>
                        </div>
                    </div>
                </form>

                <div class="text-center mt-4 pt-2 border-top">
                    <p class="small text-muted mb-0">
                        Already have an account? <a asp-action="Login" class="text-primary fw-bold">Sign In here</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
