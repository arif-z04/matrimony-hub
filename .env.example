# =====================================================================
# Matrimony Hub Environment Configuration Template
# Duplicate this file to .env and provide your production/local credentials.
# =====================================================================

# Database Configuration (MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=matrimony_hub
DB_USER=matrimony_user
DB_PASSWORD=matrimony_pass

# ASP.NET Core Connection String
ConnectionStrings__DefaultConnection="Server=127.0.0.1;Port=3307;Database=matrimony_hub;User=matrimony_user;Password=matrimony_pass;"

# Payment Gateway Configuration (BDT)
PaymentGateways__ContactUnlockFee=500.00
PaymentGateways__ActiveGateway=Sandbox

# bKash API Credentials
PaymentGateways__Bkash__AppKey=your_bkash_app_key
PaymentGateways__Bkash__AppSecret=your_bkash_app_secret
PaymentGateways__Bkash__Username=your_bkash_username
PaymentGateways__Bkash__Password=your_bkash_password
PaymentGateways__Bkash__BaseUrl=https://tokenized.sandbox.bka.sh/v1.2.0-beta

# SSLCommerz API Credentials
PaymentGateways__SSLCommerz__StoreId=your_sslcommerz_store_id
PaymentGateways__SSLCommerz__StorePassword=your_sslcommerz_store_password
PaymentGateways__SSLCommerz__IsSandbox=true

# Nagad API Credentials
PaymentGateways__Nagad__MerchantId=your_nagad_merchant_id
PaymentGateways__Nagad__PublicKey=your_nagad_public_key
PaymentGateways__Nagad__PrivateKey=your_nagad_private_key

# SMTP Email Configuration
Email__SmtpHost=smtp.example.com
Email__SmtpPort=587
Email__Username=apikey_or_user
Email__Password=smtp_secret_password
Email__FromEmail=noreply@matrimonyhub.com
Email__FromName="Matrimony Hub"
